# Google AI Studio API Key (used for LLM, STT, and TTS if using standard API)
GOOGLE_API_KEY=AIzaSy...

# Gemini Live API Settings
GEMINI_MODEL_ID=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE_NAME=Kore
GEMINI_SYSTEM_INSTRUCTION="あなたはスマートグラスを着用したユーザーをサポートする、日本語対応の優秀なAIアシスタントです。..."
GEMINI_COMPRESSION_TRIGGER=130000
GEMINI_COMPRESSION_TARGET=120000

# Google Cloud / Vertex AI Settings (required if connecting to Managed Agents / Vertex AI Live API)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GCP_AGENT_ID=your-agent-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Access key required for clients to connect via WebSocket
API_ACCESS_KEY=
